     "op": "query",
     "conn": "a",
     "sql": "SELECT v FROM conf_x3 WHERE id = 1",
     "types": [
      "int8"
     ],
     "expect_rows": [
      [
       "20"
      ]
     ]
    },
    {
     "op": "commit",
     "conn": "a"
    },
    {
     "op": "query",
     "conn": "a",

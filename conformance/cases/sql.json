     "sql": "CREATE TABLE conf_e9 (id int8 PRIMARY KEY, on_call bool)"
    },
    {
     "op": "exec",
     "sql": "INSERT INTO conf_e9 VALUES (1, true), (2, true)"
    },
    {
     "op": "isolation",
     "conn": "a",
     "level": "serializable"
    },
    {
     "op": "isolation",
     "conn": "b",
     "level": "serializable"
    },
    {
     "op": "begin",
     "conn": "a"
    },
    {
     "op": "begin",
     "conn": "b"
    },
    {
     "op": "query",
     "conn": "a",
     "sql": "SELECT count(*) FROM conf_e9 WHERE on_call",
     "types": [
      "int8"
     ],
     "expect_rows": [
      [
       "2"
      ]
     ]
    },
    {
     "op": "query",
     "conn": "b",
     "sql": "SELECT count(*) FROM conf_e9 WHERE on_call",
     "types": [
      "int8"
     ],
     "expect_rows": [
      [
       "2"
      ]
     ]
    },
    {
     "op": "exec",
     "conn": "a",
     "sql": "UPDATE conf_e9 SET on_call = false WHERE id = 1"
    },
    {
     "op": "exec",
     "conn": "b",
     "sql": "UPDATE conf_e9 SET on_call = false WHERE id = 2"
    },
    {
     "op": "commit",
     "conn": "a"
    },
    {
     "op": "commit_error",
     "conn": "b",
     "sqlstate": "40001"
    },
    {
     "op": "query",
     "sql": "SELECT count(*) FROM conf_e9 WHERE on_call",
     "types": [
      "int8"
     ],
     "expect_rows": [
      [
       "1"
      ]
     ]
    }
   ],
   "expected": "The second committer (or an earlier statement of it) fails 40001; exactly one doctor goes off call. commit_error accepts the 40001 at any statement of conn b from its UPDATE on."
  },

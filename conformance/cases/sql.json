  {
   "id": "SQL-ERR-009",
   "purpose": "A serialization failure under SERIALIZABLE surfaces as 40001 (write skew).",
   "kind": "script",
   "modes": [
    "default",
    "strict"
   ],
   "steps": [
    {
     "op": "exec",
     "sql": "DROP TABLE IF EXISTS conf_e9"
    },
